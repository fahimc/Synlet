{
  "name": "synlet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "bench:local": "pnpm build && node scripts/bench-local.mjs",
    "bench:pool": "node scripts/bench-pool-gate.mjs",
    "build": "pnpm generate:contracts && tsc -b --pretty false && node scripts/materialize-workspace-packages.mjs && pnpm --filter @synlet/web build",
    "check": "pnpm format:check && pnpm lint && pnpm check:boundaries && pnpm check:contracts-drift && pnpm typecheck && pnpm test:unit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:contracts-drift": "node scripts/generate-contracts.mjs --check",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm dev:local",
    "dev:local": "pnpm build && node scripts/start-local.mjs",
    "eval:local": "pnpm build && node scripts/eval-local.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,mjs,html,css,json}\" \"packages/**/*.{ts,tsx,json}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"config/**/*.json\" \"*.{json,yaml}\" \".github/**/*.yml\" \"docs/adr/**/*.md\" \"docs/DECISIONS.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs,html,css,json}\" \"packages/**/*.{ts,tsx,json}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"config/**/*.json\" \"*.{json,yaml}\" \".github/**/*.yml\" \"docs/adr/**/*.md\" \"docs/DECISIONS.md\"",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "lint": "eslint .",
    "package:local": "pnpm build && node scripts/package-local.mjs",
    "package:refresh-manifest": "node scripts/refresh-release-manifest.mjs",
    "smoke:models": "pnpm build && node scripts/model-diagnostics.mjs",
    "test:contracts": "pnpm build && node --test tests/contracts/*.test.mjs",
    "test:integration": "pnpm build && node --test tests/integration/*.test.mjs",
    "test:live-agent": "node --test --test-concurrency=1 tests/live/*.test.mjs",
    "test:release": "pnpm package:local && node --test tests/release/*.test.mjs",
    "test:e2e": "pnpm build && node --test tests/e2e/*.test.mjs",
    "test:security": "pnpm build && node --test tests/security/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p apps/web --pretty false && node scripts/materialize-workspace-packages.mjs",
    "test:context": "pnpm build && node --test tests/eval/*.test.mjs",
    "test:deterministic": "pnpm test:unit && pnpm test:contracts && pnpm test:integration && pnpm test:security && pnpm test:context",
    "test:python-contracts": "python scripts/test-python-contracts.py"
  },
  "devDependencies": {
    "@codedia/parser": "0.2.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@types/node": "24.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "zod": "4.6.5",
    "ajv": "8.17.1"
  }
}
