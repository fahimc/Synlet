{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synlet.local/schemas/v1/approval-decision-request.schema.json",
  "title": "ApprovalDecisionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "actionHash"],
  "properties": {
    "decision": { "enum": ["allow", "deny"] },
    "actionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
